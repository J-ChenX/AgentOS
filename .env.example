# ============================================================
# AgentOS 环境变量配置模板
# 复制此文件为 .env，填入真实值后使用
# 注意：.env 已在 .gitignore 中排除，切勿提交真实密钥
# ============================================================

# ── LLM 配置 ──────────────────────────────────────────────
# 模型名称（支持 OpenAI / Gemini / Anthropic / Ollama 等 LiteLLM 兼容模型）
GEMINI_MODEL=your-model-name-here

# OpenAI 兼容 API 基础 URL（使用官方 OpenAI 可留空）
GEMINI_BASE_URL=https://your-api-endpoint/v1

# LLM API 密钥
GEMINI_API_KEY=sk-your-api-key-here

# ── 内置 Skill 配置 ────────────────────────────────────────
# web_search skill 需要 Tavily API Key
# 获取地址：https://tavily.com
TAVILY_API_KEY=tvly-your-api-key-here

# ── 示例项目配置（可选，仅在使用对应示例时填写）─────────────
# quality_inspection 示例所需（Metac Inc ClothSeg API）
# CLOTHSEG_APP_KEY=your-app-key
# CLOTHSEG_ACCESS_KEY_ID=your-access-key-id
# CLOTHSEG_ACCESS_KEY_SECRET=your-access-key-secret
# CLOTHSEG_ENDPOINT=open.metac-inc.com
